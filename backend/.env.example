# 우리 전래동화 AI 도서관 — 환경변수 계약(.env.example)
# 실제 값은 .env 에만 두고 커밋하지 않는다. 값은 전부 placeholder — 시크릿 하드코딩 금지.

# --- DB ---
# 로컬 개발: docker-compose 의 postgres(포트 5433) 기준
DATABASE_URL=postgresql+asyncpg://library:library@localhost:5433/library

# --- Groq (LLM) ---
# https://console.groq.com/keys 에서 발급.
# AI팀 v1.3 지정 모델은 llama-3.1-70b-versatile 였지만 Groq 에서 은퇴됨(2026-07-23 실측)
# → 후속 모델 llama-3.3-70b-versatile 사용.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- 정보나루(도서관 정보나루) ---
DATA4LIBRARY_KEY=your-data4library-key

# --- 국가서지 API ---
NL_API_KEY=your-national-library-key
